+versionRange="[3.0,)"
+ordering="AFTER"
+side="CLIENT"
+
+[[dependencies.${mod_id}]]
+modId="entity_texture_features"
+type="required"
+versionRange="[7.0,)"
+ordering="AFTER"
+side="CLIENT"
+
+[[dependencies.${mod_id}]]
+modId="entity_sound_features"
+type="required"
+versionRange="[0.8,)"
